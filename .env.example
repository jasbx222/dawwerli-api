# Copy to .env (git-ignored) and fill with your own random values.
POSTGRES_PASSWORD=change_me
JWT_SIGNING_KEY=change_me_at_least_32_characters_long
PHONE_HASH_KEY=change_me
STORAGE_SIGNING_KEY=change_me
ADMIN_EMAIL=admin@dawwerli.local
ADMIN_PASSWORD=change_me
# URL the phone/emulator uses to load images (emulator: http://10.0.2.2:5080)
PUBLIC_BASE_URL=http://10.0.2.2:5080
# Development only: return the OTP in the response (no SMS gateway yet)
EXPOSE_OTP=true
